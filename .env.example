# ---------------------------------------------------------------------------
# MarkupLens configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# Pinned Nu Html Checker image. Digest of ghcr.io/validator/validator:latest
# as of 2026-10-09 (image built 2026-10-07). Fallback if this ever fails:
#   VNU_IMAGE=ghcr.io/validator/validator:24.10.17
VNU_IMAGE=ghcr.io/validator/validator@sha256:0811ae47955ff59e52862df4b4d0cba90cd6fdaa62eefc2806aecb883556e616

# Where the app reaches vnu.
#   npm run dev on your machine  -> http://localhost:8888
#   docker compose (full stack)  -> overridden to http://vnu:8888 in docker-compose.yml
VNU_URL=http://localhost:8888
VNU_TIMEOUT_MS=30000

# Allow validating private/loopback URLs (localhost, 192.168.x.x, VPN hosts).
# This is an internal tool, so it defaults to true. Set to false if the app
# is ever exposed beyond your machine. Inside Docker, localhost/127.0.0.1 are
# rewritten to host.docker.internal so XAMPP sites on your machine still work.
# The flag only unlocks loopback, 10/8, 172.16/12, 192.168/16 and fc00::/7.
# Cloud metadata (169.254.0.0/16, fd00:ec2::254, metadata.google.internal, …),
# link-local, 0.0.0.0/8, :: and other reserved ranges are ALWAYS blocked.
ALLOW_PRIVATE_URLS=true

# Host port for the app (bound to 127.0.0.1 only).
APP_PORT=3000
