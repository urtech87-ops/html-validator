{
  "name": "markuplens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs && prisma generate && prisma migrate deploy",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "node scripts/copy-monaco.mjs && prisma generate",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vnu:up": "docker compose up -d vnu",
    "vnu:down": "docker compose stop vnu",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:docker": "vitest run --config vitest.docker.config.mts",
    "fixtures:update": "node scripts/update-fixtures.mjs",
    "pretest": "prisma generate",
    "pretest:integration": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "node scripts/db-backup.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "4.4.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.53.0",
    "monaco-editor": "^0.57.0",
    "next": "16.4.0",
    "playwright-core": "1.63.0",
    "prisma": "7.10.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "pdfjs-dist": "6.3.289",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
